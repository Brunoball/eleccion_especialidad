# =====================================================================
#  TESTING · IPET 50 Elección de Especialidad
#  Copiá este archivo como .env (en esta misma carpeta) y completalo.
#  El .env NO se sube al repo (.gitignore).
# =====================================================================

# ---------- DESTINO ----------
# URL de la carpeta donde está api.php (sin /api.php al final).
# Dejá UNA sola línea activa:
#   · Local (php -S localhost:3001 desde backend/routes):
TEST_API_URL=http://localhost:3001
#   · Hostinger:
# TEST_API_URL=https://eleccion.ipet50.edu.ar/api/routes

# ---------- USUARIO ADMINISTRADOR PARA PROBAR ----------
# Tiene que existir en la base del destino elegido y ser rol "admin".
TEST_USER=
TEST_PASSWORD=

# ---------- BACKEND LOCAL AUTOMÁTICO ----------
# 1 = si TEST_API_URL es local, el test levanta solo "php -S" sobre ../backend/routes
#     (si ya lo tenés corriendo en ese puerto, usa el tuyo). En Hostinger se ignora.
TEST_START_BACKEND=1
TEST_PHP_BIN=php
TEST_PHP_INI=C:\PHP\php1\php.ini
TEST_BACKEND_DIR=../backend

# ---------- PANTALLAS (navegador) ----------
# 1 = también prueba las pantallas: levanta el frontend (npm start en ../frontend)
#     en el puerto TEST_FRONT_PORT apuntando al backend de TEST_API_URL.
# 0 = solo API (más rápido, no abre React).
TEST_UI=1
TEST_FRONT_PORT=3100
TEST_FRONTEND_DIR=../frontend

# ---------- PERMISOS DE ESCRITURA ----------
# 0 = solo lectura (seguro en cualquier destino).
# 1 = escritura REVERSIBLE: crea usuarios "e2e_...", inscribe y desinscribe un
#     alumno libre, edita cupos (solo si no hay inscripciones) y deja todo como estaba.
TEST_ALLOW_MUTATIONS=1

# 1 = pruebas DESTRUCTIVAS: Resetear elección, Limpiar todo, importar alumnos y
#     aplicar ranking. Hacen respaldo y restauran todo al final, pero borran datos
#     mientras corren. Por defecto solo se permiten contra el backend LOCAL.
TEST_ALLOW_DESTRUCTIVE=0

# Solo si de verdad querés correr las destructivas contra Hostinger
# (por ejemplo, con la base vacía antes de la elección). Dejalo en 0.
TEST_ALLOW_REMOTE_DESTRUCTIVE=0

# ---------- TIEMPOS ----------
TEST_TIMEOUT_MS=60000
TEST_EXPECT_TIMEOUT_MS=10000
# Ralentiza el navegador (ms) para ver qué hace con --headed
TEST_SLOW_MO_MS=0
